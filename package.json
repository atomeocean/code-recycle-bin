{
  "name": "atomeocean-open-source-template",
  "version": "1.0.0",
  "description": "Atomeocean 开源项目仓库模板 (VitePress + i18n)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"docs/**/*.{md,ts,vue}\" \"*.{md,json}\"",
    "format:check": "prettier --check \"docs/**/*.{md,ts,vue}\" \"*.{md,json}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.91.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.3.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-sidebar": "^1.33.0"
  },
  "dependencies": {
    "mermaid": "^11.8.1",
    "vue": "^3.5.13"
  }
}
